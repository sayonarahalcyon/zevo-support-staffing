# Copy this file to .streamlit/secrets.toml for local runs, or paste its
# contents into your Streamlit Community Cloud app's "Secrets" box.
# Never commit the real secrets.toml (with a real token) to GitHub.

INTERCOM_ACCESS_TOKEN = "your-intercom-access-token-here"

# Optional: Slack attendance (see README).
# SLACK_BOT_TOKEN = "xoxb-your-slack-bot-token"

# Optional: vacation leave log (see README, "Vacation leave log").
# Supabase project URL and the project's secret / service_role key. Server side only. Never commit the real key.
# SUPABASE_URL = "https://your-project-ref.supabase.co"
# SUPABASE_SERVICE_KEY = "your-supabase-secret-key"

# Notion backup of the leave log (optional, one-way copy from Supabase).
# NOTION_TOKEN = "your-notion-integration-token"
# NOTION_LEAVE_DB_ID = "the-32-character-id-of-the-backup-database"

# Who can open the Leave log tab. Name = "password". Erwin, Weng and Kristine all have the same access.
# Keep this table at the very bottom: in TOML, any key placed under a [table] header belongs to that table.
# [LEAVE_USERS]
# erwin = "choose-a-password"
# weng = "choose-a-password"
# kristine = "choose-a-password"
